# ==============================================================================
# MySQL 8.0 Tuning Configuration for Low-Resource Hardware
# Hardware Profile: Intel Pentium (1-2 Cores), 4 GB System RAM, 500 GB HDD
# ==============================================================================

[mysqld]
port=3307

# Memory Allocation (Keep inside 1GB container limit, total RAM is 4GB)
innodb_buffer_pool_size=512M
innodb_buffer_pool_instances=1

# Concurrency limits for 1-2 CPU cores
max_connections=30
max_connect_errors=100
thread_cache_size=4

# Disk I/O Optimization for Slow 500GB HDD
# Flush log to disk once per second rather than every transaction commit
innodb_flush_log_at_trx_commit=2
innodb_flush_method=O_DIRECT
innodb_redo_log_capacity=64M

# Disable Performance Schema to save ~200-300MB RAM overhead
performance_schema=OFF

# Network optimization (avoid slow reverse DNS lookups on local/container network)
skip-name-resolve

# Table and Cache limits
table_open_cache=200
table_definition_cache=200

# Character set
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

[client]
default-character-set=utf8mb4
